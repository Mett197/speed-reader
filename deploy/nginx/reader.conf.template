# Rendered by the nginx image entrypoint (envsubst) into /etc/nginx/conf.d/reader.conf.
# Only ${KAVITA_API_KEY} ${LL_API_KEY} ${SR_COUCH_USER_B64} are substituted (see README.md);
# every other $variable below is nginx's own.

map $arg_cmd $ll_cmd_allowed {
  default 0;
  findBook 1;
  addBook 1;
  queueBook 1;
  getWanted 1;
}

# Each LazyLibrarian command gets only the parameters it accepts (it rejects unknown ones).
map $arg_cmd $ll_args {
  default "";
  findBook "cmd=findBook&name=$arg_name";
  addBook "cmd=addBook&id=$arg_id";
  queueBook "cmd=queueBook&id=$arg_id&type=eBook";
  getWanted "cmd=getWanted";
}

server {
  listen 80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  # Kavita: only the plugin login gets the key, and the client cannot change the query.
  location = /api/kavita/api/plugin/authenticate {
    proxy_pass http://kavita:5000/api/plugin/authenticate?apiKey=${KAVITA_API_KEY}&pluginName=speedreader;
    proxy_set_header Host $host;
  }

  # Other Kavita calls pass the client's Authorization (Bearer JWT) header through.
  location /api/kavita/ {
    proxy_pass http://kavita:5000/;
    proxy_set_header Host $host;
    proxy_set_header Authorization $http_authorization;
    client_max_body_size 1m;
  }

  # LazyLibrarian: allow-listed cmd only; args are rebuilt so the client cannot pass its own apikey.
  location /api/ll/ {
    if ($ll_cmd_allowed = 0) {
      return 403;
    }
    set $args "$ll_args&apikey=${LL_API_KEY}";
    rewrite ^/api/ll/(.*)$ /$1 break;
    proxy_pass http://lazylibrarian:5299;
    proxy_set_header Host $host;
  }

  # CouchDB: fixed database, basic auth added here, only GET/POST/PUT.
  location /api/sync/ {
    limit_except GET POST PUT {
      deny all;
    }
    proxy_pass http://couchdb:5984/speedreader/;
    proxy_set_header Host $host;
    proxy_set_header Authorization "Basic ${SR_COUCH_USER_B64}";
  }

  # Kavita series cover, key added here (Kavita images authenticate by apiKey query).
  location ~ ^/api/cover/([0-9]+)$ {
    resolver 127.0.0.11 valid=30s;
    set $kavita_up kavita:5000;
    proxy_pass http://$kavita_up/api/image/series-cover?seriesId=$1&apiKey=${KAVITA_API_KEY};
    proxy_set_header Host $host;
    expires 7d;
  }

  # Device uploads into the shared ebooks root (same root as LazyLibrarian and Kavita).
  # PUT /api/upload/<Author>/<Title>/<Title>.epub ; never overwrites an existing file.
  location /api/upload/ {
    limit_except PUT {
      deny all;
    }
    alias /ebooks/;
    if (-e $request_filename) {
      return 409;
    }
    dav_methods PUT;
    create_full_put_path on;
    dav_access user:rw group:rw all:r;
    client_max_body_size 200m;
    client_body_temp_path /ebooks/.speedreader-tmp;
  }

  location /api/ {
    return 404;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
